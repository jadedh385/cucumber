# One server environment's secrets (U0.4a design §4.1). Copy to
# ~/cucumber/<staging|production>/secrets.env, fill in, then
#   chmod 600 secrets.env
# The deploy and flag commands refuse a file others can read. Keep a copy of
# each value in the password manager. Never commit a filled-in copy.

# --- Which copy: staging or production
DJANGO_ENVIRONMENT=

# --- Django
# Long random text, 50+ characters, different for each environment.
DJANGO_SECRET_KEY=
# The public name, e.g. cucumber-staging.southeastcanopy.com. The first one
# is also what the deploy command's health check asks for.
DJANGO_ALLOWED_HOSTS=
# The same name with https://, e.g. https://cucumber-staging.southeastcanopy.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Seconds browsers must keep using HTTPS: 3600 at first, 604800 (a week) once
# U0.4b confirms HTTPS works, then 31536000 (a year).
DJANGO_HSTS_SECONDS=

# --- Database passwords: long random text, all three different
# The PostgreSQL superuser (backups, first start).
POSTGRES_PASSWORD=
# cucumber_owner: migrations only.
DB_OWNER_PASSWORD=
# cucumber_app: the running app and the flag command.
DB_APP_PASSWORD=

# --- Ports on this Mac only (127.0.0.1)
# Production 8000, staging 8001.
APP_PORT=
# Production 5436, staging 5435.
DB_LOCAL_PORT=

# --- Cloudflare tunnel (U0.4b)
# This environment's own tunnel token. Without Cloudflare yet, any text.
TUNNEL_TOKEN=
# Write tunnel to start the tunnel; leave blank to run without it.
COMPOSE_PROFILES=

# --- Memory caps (U0.4a design §3.3, U0.4b design §11.2)
# Staging: 512m, 512m, 128m. Production: 1g, 1536m, 128m.
APP_MEMORY_LIMIT=
DB_MEMORY_LIMIT=
TUNNEL_MEMORY_LIMIT=
