# Copy to .env and fill in local values. Never commit .env.
# Blank lines mean "use the default" where a default is noted.

# Django
# "1" turns debug pages on (local only). Anything else, or blank, means off.
DJANGO_DEBUG=
# Long random text. Required when debug is off.
DJANGO_SECRET_KEY=
# Comma-separated host names, e.g. localhost,127.0.0.1. Required when debug is off.
DJANGO_ALLOWED_HOSTS=

# Database that Django connects to
# Default: cucumber
DB_NAME=
# cucumber_owner for migrations and tests; the live app uses cucumber_app.
# Required when debug is off (debug default: cucumber_owner).
DB_USER=
# Password for DB_USER. Required when debug is off. Locally: same as DB_OWNER_PASSWORD.
DB_PASSWORD=
# Default: 127.0.0.1
DB_HOST=
# Default: 5434 (the port compose.yaml opens locally)
DB_PORT=

# Passwords the database init script gives the two roles (Docker and CI only)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# PostgreSQL superuser password for the local Docker database
POSTGRES_PASSWORD=
